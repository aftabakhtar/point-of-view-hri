  PluginText: "<gazebo reference=\"head_r_stereo_camera_gazebo_frame\">\r\n  <sensor
    name=\"head_r_stereo_camera\" type=\"camera\">\r\n    <update_rate>4.0</update_rate>\r\n   
    <camera name=\"head_r_stereo_camera\">\r\n      <horizontal_fov>1.16762527</horizontal_fov>\r\n     
    <image>\r\n        <width>1280</width>\r\n        <height>960</height>\r\n       
    <format>R8G8B8</format>\r\n      </image>\r\n      <clip>\r\n        <near>0.05</near>\r\n       
    <far>100</far>\r\n      </clip>\r\n      <noise>\r\n        <type>gaussian</type>\r\n       
    <mean>0.0</mean>\r\n        <stddev>0.007</stddev>\r\n      </noise>\r\n    </camera>\r\n   
    <plugin filename=\"libgazebo_ros_camera.so\" name=\"camera_controller\">\r\n     
    <alwaysOn>0</alwaysOn>\r\n      <updateRate>0.0</updateRate>\r\n      <cameraName>head_r_stereo_camera</cameraName>\r\n     
    <imageTopicName>image_rect_color</imageTopicName>\r\n      <cameraInfoTopicName>camera_info</cameraInfoTopicName>\r\n     
    <frameName>head_r_stereo_camera_frame</frameName>\r\n      <robotNamespace>hsrb</robotNamespace>\r\n     
    <hackBaseline>0.14</hackBaseline>\r\n      <distortionK1>0.0</distortionK1>\r\n     
    <distortionK2>0.0</distortionK2>\r\n      <distortionK3>0.0</distortionK3>\r\n     
    <distortionT1>0.0</distortionT1>\r\n      <distortionT2>0.0</distortionT2>\r\n   
    </plugin>\r\n  </sensor>\r\n</gazebo>"
