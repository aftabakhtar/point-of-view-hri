--- !u!114 &1563600797
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1563600720}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.Robotics.UrdfImporter::Unity.Robotics.UrdfImporter.UrdfPlugin
  PluginText: "<gazebo>\r\n  <!-- IMU Plugin is a model plugin. Then it should be
    atached to HSR-B model. -->\r\n  <plugin filename=\"libgazebo_ros_imu.so\" name=\"base_imu_plugin\">\r\n   
    <imuName>base_imu</imuName>\r\n    <topicName>base_imu/data</topicName>\r\n   
    <serviceName>base_imu/calibrate</serviceName>\r\n    <frameName>base_imu_frame</frameName>\r\n   
    <bodyName>base_link</bodyName>\r\n    <robotNamespace>hsrb</robotNamespace>\r\n 
    </plugin>\r\n</gazebo>"
--- !u!114 &1563600798
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1563600720}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.Robotics.UrdfImporter::Unity.Robotics.UrdfImporter.UrdfPlugin
  PluginText: "<gazebo reference=\"base_imu_frame\">\r\n  <sensor name=\"base_imu\"
    type=\"imu\">\r\n    <update_rate>10.0</update_rate>\r\n    <imu>\r\n      <noise>\r\n       
    <type>gaussian</type>\r\n        <rate>\r\n          <mean>0.0</mean>\r\n         
    <stddev>2e-4</stddev>\r\n          <bias_mean>0.0000075</bias_mean>\r\n         
    <bias_stddev>0.0000008</bias_stddev>\r\n        </rate>\r\n        <accel>\r\n         
    <mean>0.0</mean>\r\n          <stddev>1.7e-2</stddev>\r\n          <bias_mean>0.1</bias_mean>\r\n         
    <bias_stddev>0.001</bias_stddev>\r\n        </accel>\r\n      </noise>\r\n   
    </imu>\r\n  </sensor>\r\n</gazebo>"
--- !u!114 &1563600799
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1563600720}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.Robotics.UrdfImporter::Unity.Robotics.UrdfImporter.UrdfPlugin
  PluginText: "<gazebo reference=\"base_range_sensor_link\">\r\n  <sensor name=\"base_range_sensor\"
    type=\"ray\">\r\n    <pose>0 0 0 0 0 0</pose>\r\n    <update_rate>30.0</update_rate>\r\n   
    <visualize>true</visualize>\r\n    <ray>\r\n      <scan>\r\n        <horizontal>\r\n         
    <samples>721</samples>\r\n          <resolution>1</resolution>\r\n          <min_angle>-2.1</min_angle>\r\n         
    <max_angle>2.1</max_angle>\r\n        </horizontal>\r\n      </scan>\r\n     
    <range>\r\n        <min>0.05</min>\r\n        <max>60</max>\r\n        <resolution>0.001</resolution>\r\n     
    </range>\r\n    </ray>\r\n    <plugin filename=\"libgazebo_ros_laser.so\" name=\"laser\">\r\n     
    <topicName>hsrb/base_scan</topicName>\r\n      <frameName>base_range_sensor_link</frameName>\r\n   
    </plugin>\r\n  </sensor>\r\n</gazebo>"
