--- !u!114 &1563600750
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1563600720}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.Robotics.UrdfImporter::Unity.Robotics.UrdfImporter.UrdfPlugin
  PluginText: "<gazebo reference=\"hand_camera_gazebo_frame\">\r\n  <sensor name=\"hand_camera\"
    type=\"camera\">\r\n    <update_rate>10.0</update_rate>\r\n    <camera name=\"hand_camera\">\r\n     
    <horizontal_fov>2.00</horizontal_fov>\r\n      <image>\r\n        <width>640</width>\r\n       
    <height>480</height>\r\n        <format>R8G8B8</format>\r\n      </image>\r\n     
    <clip>\r\n        <near>0.05</near>\r\n        <far>100</far>\r\n      </clip>\r\n     
    <noise>\r\n        <type>gaussian</type>\r\n        <mean>0.0</mean>\r\n       
    <stddev>0.007</stddev>\r\n      </noise>\r\n    </camera>\r\n    <plugin filename=\"libhsrb_gazebo_ros_camera.so\"
    name=\"camera_controller\">\r\n      <robotNamespace>hsrb</robotNamespace>\r\n     
    <alwaysOn>0</alwaysOn>\r\n      <updateRate>0.0</updateRate>\r\n      <cameraName>hand_camera</cameraName>\r\n     
    <imageTopicName>image_raw</imageTopicName>\r\n      <cameraInfoTopicName>camera_info</cameraInfoTopicName>\r\n     
    <frameName>hand_camera_frame</frameName>\r\n      <hackBaseline>0.07</hackBaseline>\r\n     
    <distortionK1>0.0</distortionK1>\r\n      <distortionK2>0.0</distortionK2>\r\n     
    <distortionK3>0.0</distortionK3>\r\n      <distortionT1>0.0</distortionT1>\r\n     
    <distortionT2>0.0</distortionT2>\r\n    </plugin>\r\n  </sensor>\r\n</gazebo>"
