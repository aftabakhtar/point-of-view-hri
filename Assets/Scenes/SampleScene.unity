--- !u!114 &1563600779
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1563600720}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.Robotics.UrdfImporter::Unity.Robotics.UrdfImporter.UrdfPlugin
  PluginText: "<gazebo reference=\"head_rgbd_sensor_gazebo_frame\">\r\n  <sensor
    name=\"openni_camera_camera\" type=\"depth\">\r\n    <always_on>0</always_on>\r\n   
    <update_rate>30</update_rate>\r\n    <visualize>true</visualize>\r\n    <camera>\r\n     
    <horizontal_fov>1.047</horizontal_fov>\r\n      <image>\r\n        <width>640</width>\r\n       
    <height>480</height>\r\n        <format>B8G8R8</format>\r\n      </image>\r\n     
    <depth_camera></depth_camera>\r\n      <clip>\r\n        <near>0.1</near>\r\n       
    <far>100</far>\r\n      </clip>\r\n    </camera>\r\n    <plugin filename=\"libgazebo_ros_openni_kinect.so\"
    name=\"head_rgbd_sensor_controller\">\r\n      <alwaysOn>true</alwaysOn>\r\n     
    <baseline>0.2</baseline>\r\n      <updateRate>1.0</updateRate>\r\n      <cameraName>head_rgbd_sensor</cameraName>\r\n     
    <frameName>head_rgbd_sensor_rgb_frame</frameName>\r\n      <imageTopicName>/hsrb/head_rgbd_sensor/rgb/image_rect_color</imageTopicName>\r\n     
    <cameraInfoTopicName>/hsrb/head_rgbd_sensor/rgb/camera_info</cameraInfoTopicName>\r\n     
    <depthImageTopicName>/hsrb/head_rgbd_sensor/depth_registered/image_rect_raw</depthImageTopicName>\r\n     
    <pointCloudTopicName>/hsrb/head_rgbd_sensor/depth_registered/rectified_points</pointCloudTopicName>\r\n     
    <depthImageCameraInfoTopicName>/hsrb/head_rgbd_sensor/depth_registered/camera_info</depthImageCameraInfoTopicName>\r\n     
    <pointCloudCutoff>0.5</pointCloudCutoff>\r\n      <pointCloudCutoffMax>9.2</pointCloudCutoffMax>\r\n     
    <distortionK1>0.0</distortionK1>\r\n      <distortionK2>0.0</distortionK2>\r\n     
    <distortionK3>0.0</distortionK3>\r\n      <distortionT1>0.0</distortionT1>\r\n     
    <distortionT2>0.0</distortionT2>\r\n      <CxPrime>0.0</CxPrime>\r\n      <Cx>0.0</Cx>\r\n     
    <Cy>0.0</Cy>\r\n      <focalLength>0.0</focalLength>\r\n      <hackBaseline>0</hackBaseline>\r\n   
    </plugin>\r\n  </sensor>\r\n</gazebo>"
--- !u!114 &1563600780
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1563600720}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.Robotics.UrdfImporter::Unity.Robotics.UrdfImporter.UrdfPlugin
  PluginText: "<gazebo reference=\"head_center_camera_gazebo_frame\">\r\n  <sensor
    name=\"head_center_camera\" type=\"camera\">\r\n    <update_rate>10.0</update_rate>\r\n   
    <camera name=\"head_center_camera\">\r\n      <horizontal_fov>2.00</horizontal_fov>\r\n     
    <image>\r\n        <width>640</width>\r\n        <height>480</height>\r\n       
    <format>R8G8B8</format>\r\n      </image>\r\n      <clip>\r\n        <near>0.05</near>\r\n       
    <far>100</far>\r\n      </clip>\r\n      <noise>\r\n        <type>gaussian</type>\r\n       
    <mean>0.0</mean>\r\n        <stddev>0.007</stddev>\r\n      </noise>\r\n    </camera>\r\n   
    <plugin filename=\"libhsrb_gazebo_ros_camera.so\" name=\"camera_controller\">\r\n     
    <robotNamespace>hsrb</robotNamespace>\r\n      <alwaysOn>0</alwaysOn>\r\n     
    <updateRate>0.0</updateRate>\r\n      <cameraName>head_center_camera</cameraName>\r\n     
    <imageTopicName>image_raw</imageTopicName>\r\n      <cameraInfoTopicName>camera_info</cameraInfoTopicName>\r\n     
    <frameName>head_center_camera_frame</frameName>\r\n      <hackBaseline>0.07</hackBaseline>\r\n     
    <distortionK1>0.0</distortionK1>\r\n      <distortionK2>0.0</distortionK2>\r\n     
    <distortionK3>0.0</distortionK3>\r\n      <distortionT1>0.0</distortionT1>\r\n     
    <distortionT2>0.0</distortionT2>\r\n    </plugin>\r\n  </sensor>\r\n</gazebo>"
